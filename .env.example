[TEMPLATE]
# ---- LLM (Groq) ----
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq chat model with tool-calling support
AGENT_MODEL=openai/gpt-oss-120b

# ---- Hindsight internal models (Gemini free tier) ----
# Hindsight's own fact-extraction LLM and embeddings use Gemini: Groq's free
# tier (8k tokens/min) cannot serve Hindsight retains (~64k tokens each).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Database (application data) ----
# Local dev default (no setup needed):
DATABASE_URL=sqlite:///./incidentmind.db
# With the bundled docker-compose Postgres:
# DATABASE_URL=postgresql+psycopg://incidentmind:incidentmind@localhost:5432/incidentmind

# ---- Hindsight (agent memory) ----
# Self-hosted via `docker compose up hindsight` (see docker-compose.yml)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incidentmind
# Toggle the memory layer globally (demo A/B switch)
MEMORY_ENABLED=true

# ---- Frontend ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://monumental-khapse-b6b78e.netlify.app
